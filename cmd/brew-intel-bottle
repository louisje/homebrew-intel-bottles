#!/usr/bin/env python3
"""Homebrew Intel bottle helper; all non-install commands pass through unchanged."""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Any

REPO = os.environ.get("INTEL_BOTTLE_REPO", "louisje/homebrew-intel-bottles")
REAL_BREW = os.environ.get("INTEL_BOTTLE_BREW", "/usr/local/bin/brew")
FORMULA_PATTERN = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9@+_.-]*$")
TAPPED_FORMULA_PATTERN = re.compile(
    r"^[a-zA-Z0-9][a-zA-Z0-9@+_.-]*/[a-zA-Z0-9][a-zA-Z0-9@+_.-]*/[a-zA-Z0-9][a-zA-Z0-9@+_.-]*$"
)
CORE_TAP = "homebrew/core"
MACOS_TAGS = {13: "ventura", 14: "sonoma", 15: "sequoia", 16: "tahoe"}


class BottleError(RuntimeError):
    pass


class ThirdPartyDependency(BottleError):
    """A core formula depends on a non-core tap; install via native brew."""
    pass


def message(value: str) -> None:
    print("intel-bottle: " + value, file=sys.stderr)


def brew(*args: str, capture: bool = True) -> str:
    result = subprocess.run(
        [REAL_BREW, *args], text=True,
        capture_output=capture, check=False,
    )
    if result.returncode:
        raise BottleError(
            "brew " + " ".join(args) + " failed: "
            + (result.stderr.strip() or result.stdout.strip())
        )
    return result.stdout.strip() if capture else ""


def passthrough(args: list[str]) -> int:
    return subprocess.call([REAL_BREW, *args])


def check_platform() -> str:
    if platform.system() != "Darwin" or platform.machine() != "x86_64":
        raise BottleError("custom bottles currently support Intel macOS only")
    version = platform.mac_ver()[0]
    major = int(version.split(".")[0]) if version else 0
    if major not in MACOS_TAGS:
        raise BottleError("unsupported macOS version: " + version)
    prefix = brew("--prefix")
    if prefix != "/usr/local":
        raise BottleError("custom bottles require /usr/local (found " + prefix + ")")
    return MACOS_TAGS[major]


def formula_info(name: str) -> dict[str, Any]:
    obj = json.loads(brew("info", "--json=v2", "--formula", name))
    formulae = obj.get("formulae", [])
    if len(formulae) != 1:
        raise BottleError("could not resolve formula " + name)
    return formulae[0]


def formula_infos(names: list[str]) -> dict[str, dict[str, Any]]:
    data = json.loads(brew("info", "--json=v2", "--formula", *names))
    info = {f["name"]: f for f in data.get("formulae", [])}
    missing = set(names) - set(info)
    if missing:
        raise BottleError("could not resolve formulae: " + ", ".join(sorted(missing)))
    return info


def requested_packages(names: list[str]) -> list[dict[str, Any]]:
    """Resolve Formulae *and* Casks, including their Tap ownership, in one query.

    brew info --json=v2 --formula rejects Casks. Without that flag Homebrew
    returns both kinds, in separate "formulae" and "casks" arrays.
    """
    data = json.loads(brew("info", "--json=v2", *names))
    candidates = [
        {**formula, "kind": "formula"}
        for formula in data.get("formulae", [])
    ]
    candidates.extend(
        {
            "name": cask["token"],
            "tap": cask.get("tap"),
            "full_name": cask.get("full_token") or cask["token"],
            "kind": "cask",
        }
        for cask in data.get("casks", [])
    )
    resolved: list[dict[str, Any]] = []
    for name in names:
        parts = name.split("/")
        basename = parts[-1]
        expected_tap = "/".join(parts[:2]) if len(parts) == 3 else None
        candidate = next(
            (item for item in candidates
             if item.get("name") == basename
             and (expected_tap is None or item.get("tap") == expected_tap)),
            None,
        )
        if candidate is None:
            raise BottleError("could not resolve Formula/Cask and Tap: " + name)
        if not candidate.get("tap"):
            raise BottleError("missing Tap identity for: " + name)
        resolved.append(candidate)
    return resolved


def native_tap_install_args(
    rest: list[str], names: list[str], roots: list[dict[str, Any]]
) -> list[str]:
    """Qualify third-party short names, for both Formulae and Casks."""
    qualified: dict[str, str] = {}
    for requested, info in zip(names, roots):
        if info["tap"] in {CORE_TAP, "homebrew/cask"}:
            continue
        full_name = info.get("full_name") or f"{info['tap']}/{info['name']}"
        if not TAPPED_FORMULA_PATTERN.fullmatch(full_name):
            raise BottleError(f"unsafe resolved third-party package: {full_name}")
        qualified[requested] = full_name
    return ["install", *(qualified.get(arg, arg) for arg in rest)]


def all_installed_versions() -> dict[str, list[str]]:
    installed: dict[str, list[str]] = {}
    for line in brew("list", "--versions", "--formula").splitlines():
        parts = line.split()
        if parts:
            installed[parts[0]] = parts[1:]
    return installed


def stable_version(info: dict[str, Any]) -> str:
    value = (info.get("versions") or {}).get("stable")
    if not value:
        raise BottleError("no stable version for " + info["name"])
    # Homebrew's pkg_version includes the Formula revision, which is separate
    # from versions.stable in brew info --json=v2 (e.g. aria2 1.37.0_3).
    revision = int(info.get("revision") or 0)
    return str(value) + ("_" + str(revision) if revision else "")


def official_bottle(info: dict[str, Any], tag: str) -> bool:
    files = ((info.get("bottle") or {}).get("stable") or {}).get("files") or {}
    return tag in files


def installed_versions(name: str) -> list[str]:
    raw = brew("list", "--versions", "--formula", name)
    chunks = raw.split()
    return chunks[1:] if chunks and chunks[0] == name else []


def github_api(path: str) -> Any:
    gh = shutil.which("gh")
    if gh:
        result = subprocess.run(
            [gh, "api", "-H", "Accept: application/vnd.github+json", path],
            capture_output=True, text=True, check=False,
        )
        if result.returncode == 0:
            return json.loads(result.stdout)
    url = "https://api.github.com/" + path.lstrip("/")
    headers = {"Accept": "application/vnd.github+json", "User-Agent": "brew-intel-bottle"}
    token = os.getenv("GH_TOKEN") or os.getenv("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = "Bearer " + token
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=25) as response:
            return json.load(response)
    except (OSError, ValueError) as exc:
        raise BottleError("GitHub API request failed: " + str(exc)) from exc


def read_url(url: str) -> bytes:
    try:
        with urllib.request.urlopen(
            urllib.request.Request(url, headers={"User-Agent": "brew-intel-bottle"}), timeout=60
        ) as response:
            return response.read()
    except OSError as exc:
        raise BottleError("download failed (" + url + "): " + str(exc)) from exc


@dataclass(frozen=True)
class Bottle:
    name: str
    version: str
    filename: str
    sha256: str
    download_url: str
    release_url: str
    cellar: str


class ReleaseCatalog:
    def __init__(self, tag: str) -> None:
        self.tag = tag
        self.releases: list[dict[str, Any]] | None = None
        self.cache: dict[tuple[str, str], Bottle | None] = {}

    def all(self) -> list[dict[str, Any]]:
        if self.releases is None:
            data = github_api("repos/" + REPO + "/releases?per_page=100")
            if not isinstance(data, list):
                raise BottleError("unexpected GitHub releases response")
            self.releases = [r for r in data if not r.get("draft") and not r.get("prerelease")]
        return self.releases

    def find(self, name: str, version: str, cellar: str) -> Bottle | None:
        key = (name, version)
        if key in self.cache:
            return self.cache[key]
        prefix = name + "--" + version + "." + self.tag + ".bottle"
        for release in self.all():
            assets = {a["name"]: a for a in release.get("assets", [])}
            for asset_name, asset in assets.items():
                if not asset_name.startswith(prefix) or not asset_name.endswith(".json"):
                    continue
                meta = json.loads(read_url(asset["browser_download_url"]))
                entry = meta.get(name, {})
                if str((entry.get("formula") or {}).get("pkg_version")) != version:
                    continue
                bottle = entry.get("bottle") or {}
                target = (bottle.get("tags") or {}).get(self.tag)
                if not target:
                    continue
                # Metadata is a description, not an installation instruction.
                compatible_cellars = {"any", "any_skip_relocation", ":any", ":any_skip_relocation", cellar}
                if str(bottle.get("cellar")) not in compatible_cellars:
                    continue
                archive = assets.get(target["local_filename"])
                if not archive:
                    continue
                result = Bottle(
                    name=name, version=version, filename=archive["name"],
                    sha256=target["sha256"],
                    download_url=archive["browser_download_url"],
                    release_url=release["html_url"],
                    cellar=str(bottle["cellar"]),
                )
                self.cache[key] = result
                return result
        self.cache[key] = None
        return None


def validate_formula(name: str) -> None:
    if not FORMULA_PATTERN.fullmatch(name):
        raise BottleError("expected an unqualified Homebrew formula name, got: " + name)


def dependencies(name: str) -> list[str]:
    # brew deps --topological includes transitive required and recommended deps.
    values = brew("deps", "--topological", "--formula", name).splitlines()
    result: list[str] = []
    for value in values:
        value = value.strip()
        if not value:
            continue
        if "/" in value:
            if not value.startswith(CORE_TAP + "/"):
                raise ThirdPartyDependency(
                    f"{name} requires third-party dependency {value}"
                )
            value = value.rsplit("/", 1)[-1]
        result.append(value)
    return result


@dataclass
class Planned:
    name: str
    version: str
    source: str
    bottle: Bottle | None = None


def installation_plan(names: list[str], tag: str, catalog: ReleaseCatalog) -> list[Planned]:
    queue: list[str] = []
    for name in names:
        validate_formula(name)
        queue.extend(dependencies(name))
        queue.append(name)
    # Each dependency appears before its dependents; preserve order without duplicates.
    queue = list(dict.fromkeys(queue))
    cellar = brew("--cellar")
    infos = formula_infos(queue)
    for name, info in infos.items():
        if info.get("tap") != CORE_TAP:
            raise ThirdPartyDependency(
                f"dependency {name} belongs to {info.get('tap') or 'unknown Tap'}"
            )
    installed_map = all_installed_versions()
    actions: list[Planned] = []
    for name in queue:
        info = infos[name]
        version = stable_version(info)
        installed = installed_map.get(name, [])
        if version in installed:
            actions.append(Planned(name, version, "installed"))
            continue
        if installed and name not in names:
            # Existing dependencies must not be forcibly downgraded or
            # upgraded here. Leave their compatibility checks to Homebrew.
            # A Formula can legitimately be older than the installed version.
            actions.append(Planned(name, ", ".join(installed), "installed"))
            continue
        if official_bottle(info, tag):
            actions.append(Planned(name, version, "official"))
            continue
        candidate = catalog.find(name, version, cellar)
        actions.append(Planned(name, version, "release" if candidate else "missing", candidate))
    return actions


def print_plan(plan: list[Planned]) -> None:
    for action in plan:
        label = {"installed": "installed", "official": "Homebrew bottle",
                 "release": "GitHub Release", "missing": "MISSING"}[action.source]
        print("  {name} {version}: {label}".format(name=action.name, version=action.version, label=label))
        if action.bottle:
            print("    " + action.bottle.release_url)



# The REST workflow-run resource does not expose workflow_dispatch inputs.
# New runs advertise pinned versions in job names; older unversioned runs
# are treated as potentially overlapping rather than incorrectly exact matches.
JOB_NAME_PATTERN = re.compile(r"^([A-Za-z0-9@+_.-]+) \[([A-Za-z0-9.+_~-]*)\]$")
RUN_NAME_PATTERN = re.compile(r"^Intel Bottles \[([^\]]+)\] versions=\[([^\]]*)\]$")
ACTIVE_RUN_STATES = {"queued", "in_progress", "waiting", "requested", "pending"}


@dataclass(frozen=True)
class CloudJob:
    name: str
    version: str | None
    status: str
    conclusion: str | None
    url: str
    run_id: int
    run_status: str

    @property
    def active(self) -> bool:
        return self.status in ACTIVE_RUN_STATES or (
            self.status == "completed" and self.conclusion == "success"
            and self.run_status in ACTIVE_RUN_STATES
        )


class WorkflowCatalog:
    """Find cloud jobs by Formula + revision, without assuming old run versions."""

    def __init__(self, *, history_limit: int = 3) -> None:
        self._jobs: list[CloudJob] | None = None
        self.history_limit = history_limit

    def all(self) -> list[CloudJob]:
        if self._jobs is not None:
            return self._jobs
        result = github_api(
            "repos/" + REPO + "/actions/workflows/build.yml/runs?per_page=100"
        )
        runs = result.get("workflow_runs", [])
        if not isinstance(runs, list):
            raise BottleError("unexpected workflow runs response")
        all_jobs: list[CloudJob] = []
        completed_scanned = 0
        for run in runs:
            run_status = str(run.get("status") or "")
            is_active = run_status in ACTIVE_RUN_STATES
            if not is_active:
                if completed_scanned >= self.history_limit:
                    continue
                completed_scanned += 1
            run_id = int(run["id"])
            jobs = github_api(
                "repos/" + REPO + "/actions/runs/" + str(run_id) + "/jobs?per_page=100"
            ).get("jobs", [])
            names_seen: set[str] = set()
            for job in jobs:
                name = str(job.get("name", ""))
                found = JOB_NAME_PATTERN.fullmatch(name)
                formula, version = (found.group(1), found.group(2) or None) if found else (name, None)
                # Coordinator jobs are not Formula builds.
                if not FORMULA_PATTERN.fullmatch(formula) or formula in {"prepare", "publish"}:
                    continue
                names_seen.add(formula)
                all_jobs.append(CloudJob(
                    name=formula, version=version,
                    status=str(job.get("status") or ""),
                    conclusion=job.get("conclusion"),
                    url=str(job.get("html_url") or run.get("html_url") or ""),
                    run_id=run_id, run_status=run_status,
                ))
            # Before jobs are created, infer requested versions from run-name.
            title_match = RUN_NAME_PATTERN.fullmatch(str(run.get("display_title", "")))
            if is_active and title_match:
                requested_names = [n.strip() for n in title_match.group(1).split(",")]
                pins = {}
                for pair in title_match.group(2).split(","):
                    if "=" in pair:
                        n, v = pair.strip().split("=", 1)
                        pins[n] = v
                for name in requested_names:
                    if FORMULA_PATTERN.fullmatch(name) and name not in names_seen:
                        all_jobs.append(CloudJob(
                            name=name, version=pins.get(name),
                            status="queued", conclusion=None,
                            url=str(run.get("html_url") or ""),
                            run_id=run_id, run_status=run_status,
                        ))
        self._jobs = all_jobs
        return all_jobs

    def match(self, name: str, version: str) -> tuple[CloudJob | None, CloudJob | None]:
        jobs = [job for job in self.all() if job.name == name]
        # Strictly versioned jobs are preferred; unknown-version legacy jobs
        # are not presumed to match, but prevent blind duplicates.
        for job in jobs:
            if job.active and job.version == version:
                return job, None
        for job in jobs:
            if job.active and job.version is None:
                return job, None
        for job in jobs:
            if job.version == version and job.conclusion in {"failure", "cancelled", "timed_out"}:
                return None, job
        return None, None


def list_cloud_jobs(*, include_completed: bool = False, formula: str | None = None) -> int:
    """Show active or recent cloud Formula jobs, not the prepare job."""
    if formula is not None:
        validate_formula(formula)
    # Keep normal installs inexpensive; --all deliberately queries more
    # historical runs. GitHub limits the initial list to 100 recent runs.
    catalog = WorkflowCatalog(history_limit=20 if include_completed else 0)
    jobs = [
        job for job in catalog.all()
        if (formula is None or job.name == formula)
        and (include_completed or job.status in ACTIVE_RUN_STATES)
    ]
    title = "active and recent" if include_completed else "active"
    if not jobs:
        print(f"No {title} Intel Bottle jobs found"
              + (f" for {formula}." if formula else "."))
        return 0
    print(f"Intel Bottle cloud jobs ({title}) — {REPO}")
    for job in jobs:
        state = job.conclusion if job.status == "completed" else job.status
        version = job.version or "version unverified"
        print(f"  {job.name} {version}: {state} (run #{job.run_id})")
        print(f"    {job.url}")
    return 0


def parse_jobs_options(rest: list[str]) -> int:
    if rest in (["--help"], ["-h"]):
        print("Usage: brew intel-bottle jobs [--all] [FORMULA]\n"
              "  Default: active queued/in-progress jobs only.\n"
              "  --all: include jobs from the latest 20 completed workflow runs.\n"
              "  FORMULA: filter by formula name, e.g. aria2.")
        return 0
    unknown = [x for x in rest if x.startswith("-") and x != "--all"]
    names = [x for x in rest if x != "--all"]
    if unknown or len(names) > 1:
        raise BottleError("usage: brew intel-bottle jobs [--all] [FORMULA]")
    return list_cloud_jobs(include_completed="--all" in rest,
                           formula=names[0] if names else None)


def build_candidates(plan: list[Planned], requested: list[str]) -> list[Planned]:
    """Dispatch only missing roots; the cloud root job also bottles dependencies."""
    missing = {item.name: item for item in plan if item.source == "missing"}
    if not missing:
        return []
    requested_missing = [name for name in requested if name in missing]
    dep_map = {name: set(dependencies(name)) for name in requested_missing}
    roots = [
        name for name in requested_missing
        if not any(name in deps for parent, deps in dep_map.items() if parent != name)
    ]
    covered = set()
    for root in roots:
        covered.update(dep_map[root])
    # A missing root also bundles its dependencies. If the root already has
    # a bottle but a dependency does not, schedule the dependency separately.
    return [item for item in plan if item.name in missing
            and (item.name in roots or item.name not in covered)]


def show_cloud_jobs(
    candidates: list[Planned], catalog: WorkflowCatalog,
) -> tuple[list[Planned], bool]:
    """Return uncovered jobs and whether anything is already underway."""
    needed: list[Planned] = []
    waiting = False
    for item in candidates:
        active, previous = catalog.match(item.name, item.version)
        if active:
            waiting = True
            label = "exact version" if active.version == item.version else "version NOT VERIFIED"
            print(
                f"  {item.name} {item.version}: cloud {active.status} ({label})"
                f"\n    {active.url}"
            )
            continue
        if previous:
            message(
                f"previous build {previous.conclusion}: {item.name} {item.version}"
                f"\n    {previous.url}"
            )
        needed.append(item)
    return needed, waiting


def download_verified(bottle: Bottle, folder: Path) -> Path:
    result = folder / bottle.filename
    # Only use a filename selected from bottle metadata, never a supplied URL path.
    if result.name != bottle.filename or "/" in bottle.filename or ".." in bottle.filename:
        raise BottleError("unsafe bottle filename")
    headers = {"User-Agent": "brew-intel-bottle"}
    digest = hashlib.sha256()
    try:
        with urllib.request.urlopen(urllib.request.Request(bottle.download_url, headers=headers), timeout=180) as stream:
            with result.open("wb") as output:
                while True:
                    block = stream.read(1024 * 1024)
                    if not block:
                        break
                    digest.update(block)
                    output.write(block)
    except OSError as exc:
        result.unlink(missing_ok=True)
        raise BottleError("failed to download " + bottle.name + ": " + str(exc)) from exc
    if digest.hexdigest().lower() != bottle.sha256.lower():
        result.unlink(missing_ok=True)
        raise BottleError("SHA256 mismatch for " + bottle.filename)
    return result


def dispatch_build(items: list[Planned]) -> int:
    if not items:
        return 0
    if not shutil.which("gh"):
        raise BottleError("GitHub CLI 'gh' is required to trigger cloud builds")
    versions = ",".join(item.name + "=" + item.version for item in items)
    formulae = ",".join(item.name for item in items)
    cmd = [
        "gh", "workflow", "run", "build.yml", "--repo", REPO,
        "-f", "formulae=" + formulae,
        "-f", "versions=" + versions,
        "-f", "skip_if_bottled=false",
    ]
    result = subprocess.run(cmd, check=False)
    if result.returncode == 0:
        print("Cloud build requested: " + versions)
        print("https://github.com/" + REPO + "/actions/workflows/build.yml")
    return result.returncode


def trigger_build(names: list[str], *, force: bool = False) -> int:
    if not names:
        raise BottleError("specify at least one formula")
    candidates: list[Planned] = []
    for name in dict.fromkeys(names):
        validate_formula(name)
        info = formula_info(name)
        if info.get("tap") != CORE_TAP:
            raise BottleError(
                f"{name} belongs to {info.get('tap') or 'unknown Tap'}; "
                "third-party formulas must be built/installed locally with native brew"
            )
        deps = dependencies(name)
        if deps:
            dep_infos = formula_infos(deps)
            for dep, dep_info in dep_infos.items():
                if dep_info.get("tap") != CORE_TAP:
                    raise BottleError(
                        f"{name} depends on {dep} from {dep_info.get('tap')}; "
                        "not eligible for Intel Bottle cloud build"
                    )
        candidates.append(Planned(name, stable_version(info), "missing"))
    if not force:
        candidates, _ = show_cloud_jobs(candidates, WorkflowCatalog())
    if not candidates:
        message("matching or unverified cloud builds already exist; no duplicate scheduled")
        return 0
    return dispatch_build(candidates)


def install(names: list[str], *, dry_run: bool = False, yes: bool = False) -> int:
    tag = check_platform()
    catalog = ReleaseCatalog(tag)
    print("Checking Intel " + tag + " bottles...")
    plan = installation_plan(names, tag, catalog)
    print_plan(plan)
    missing = [entry.name for entry in plan if entry.source == "missing"]
    if missing:
        candidates = build_candidates(plan, names)
        bundled = set(missing) - {item.name for item in candidates}
        message("missing bottles: " + ", ".join(missing))
        if bundled:
            message("dependency bottles to be built with their parent formula: "
                    + ", ".join(sorted(bundled)))
        new_jobs, existing = show_cloud_jobs(candidates, WorkflowCatalog())
        if not new_jobs:
            message("already queued/building on GitHub; no new job required"
                    if existing else "no new build required")
        else:
            message("new cloud jobs required: " + ", ".join(
                item.name + "=" + item.version for item in new_jobs
            ))
        if dry_run:
            return 0
        if new_jobs and sys.stdin.isatty() and not yes:
            answer = input("Schedule only the missing cloud jobs? [y/N] ").strip().lower()
            if answer in {"y", "yes"}:
                return 2 if dispatch_build(new_jobs) == 0 else 1
        if new_jobs:
            message("to build remotely: brew intel-bottle build "
                    + " ".join(item.name for item in new_jobs))
        return 2
    if dry_run:
        return 0

    if not yes and any(entry.source == "release" for entry in plan) and sys.stdin.isatty():
        answer = input("Install the listed GitHub Release bottles? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            message("cancelled; nothing installed")
            return 1

    with tempfile.TemporaryDirectory(prefix="intel-bottles-") as work:
        root = Path(work)
        for item in plan:
            if item.source == "installed":
                continue
            if item.source == "official":
                message("installing official bottle: " + item.name)
                rc = subprocess.call([REAL_BREW, "install", "--force-bottle", item.name])
            else:
                assert item.bottle is not None
                message("verifying GitHub bottle: " + item.bottle.filename)
                archive = download_verified(item.bottle, root)
                message("installing " + item.name + " using Homebrew")
                rc = subprocess.call([REAL_BREW, "install", str(archive)])
            if rc != 0:
                return rc
    return 0


HELP = """Usage: brew <command> [options]
       brew intel-bottle <command> [options]

Intel Bottle extensions (Intel macOS; Homebrew with Bottle fallback):
  install [--dry-run] [--yes] FORMULA [...]
      Prefer official bottles, then verified Intel GitHub Release bottles.
      Missing bottles can be scheduled for cloud builds; never silently
      compile missing source packages locally.
  status FORMULA
      Show official/self-hosted Bottle availability and cloud build status.
  releases
      List recently published Intel Bottle releases.
  build [--force] FORMULA [...]
      Request missing cloud builds (avoid duplicate active jobs).
      --force explicitly overrides duplicate protection.
  jobs [--all] [FORMULA]
      List active cloud jobs. --all includes recent completed jobs;
      optionally filter by Formula.
  help, -h, --help
      Show this combined Intel Bottle and Homebrew compatibility help.

Original Homebrew commands (forwarded unchanged):
  search TEXT|/REGEX/         Find Formulae and Casks.
  info [FORMULA|CASK...]      Show package information.
  list [FORMULA|CASK...]      List installed packages.
  update                      Update Homebrew metadata.
  upgrade [FORMULA|CASK...]   Upgrade installed packages (native Homebrew).
  uninstall FORMULA|CASK...   Remove packages.
  outdated                    List outdated packages.
  doctor                      Diagnose Homebrew issues.
  config                      Show Homebrew configuration.
  --version                   Show Homebrew version.

Other Homebrew commands and options are passed through unchanged.
Casks and third-party Tap Formulae (qualified or unqualified) are installed
by native Homebrew, with its own download/Bottle/source policy; they are
NEVER sent to Intel Bottle cloud builds. Mixed Formula/Cask or core/third-
party batches are entirely delegated to native Homebrew. Core Formulae with
third-party dependencies also fall back to native Homebrew.
Note: install with --HEAD or other unsupported options is also forwarded
to Homebrew; it does NOT use Intel Bottle safety checks.
For full native Homebrew help: command brew --help
Transparent interactive Bash alias: alias brew='brew intel-bottle'
"""


def main(args: list[str]) -> int:
    # An interactive alias expands brew --help into
    # brew intel-bottle --help; both show the combined help.
    # Accept the retired --proxy marker for existing sessions until reloaded.
    if args and args[0] == "--proxy":
        args = args[1:]
    if args and args[0] == "intel-bottle":
        args = args[1:]
    if not args:
        print(HELP)
        return 0
    cmd, *rest = args
    if cmd in {"help", "-h", "--help"}:
        print(HELP)
        return 0
    if cmd == "jobs":
        return parse_jobs_options(rest)
    if cmd == "build":
        force = "--force" in rest
        return trigger_build([name for name in rest if name != "--force"], force=force)
    if cmd == "status":
        if len(rest) != 1 or not (
            FORMULA_PATTERN.fullmatch(rest[0]) or TAPPED_FORMULA_PATTERN.fullmatch(rest[0])
        ):
            raise BottleError("usage: brew intel-bottle status FORMULA")
        info = requested_packages([rest[0]])[0]
        if info.get("kind") == "cask":
            print(f"{info.get('full_name') or rest[0]} (Cask)")
            print("  Installation: native Homebrew")
            print("  Intel Bottle cloud builds: not used")
            return 0
        version = stable_version(info)
        if info.get("tap") != CORE_TAP:
            print(f"{info.get('full_name') or rest[0]} {version}")
            print("  Third-party Tap: native Homebrew handles installation and dependencies")
            print("  Intel Bottle cloud builds: not used")
            return 0
        tag = check_platform()
        print(rest[0] + " " + version + " (" + tag + ")")
        print("  Homebrew official bottle:", "available" if official_bottle(info, tag) else "not available")
        hosted = ReleaseCatalog(tag).find(rest[0], version, brew("--cellar"))
        print("  Intel release bottle:", hosted.release_url if hosted else "not published")
        if not hosted and not official_bottle(info, tag):
            active, prior = WorkflowCatalog().match(rest[0], version)
            if active:
                print(f"  Cloud build: {active.status} ({active.version or 'version unverified'})")
                print("  " + active.url)
            elif prior:
                print(f"  Previous cloud build: {prior.conclusion}")
                print("  " + prior.url)
        return 0
    if cmd == "releases":
        if rest:
            raise BottleError("usage: brew intel-bottle releases")
        catalog = ReleaseCatalog(check_platform())
        for release in catalog.all():
            print(release["tag_name"] + "  " + release["html_url"])
        return 0
    if cmd == "install":
        dry_run, yes = "--dry-run" in rest, "--yes" in rest
        names = [x for x in rest if x not in {"--dry-run", "--yes"}]
        if not names or any(
            not (FORMULA_PATTERN.fullmatch(name) or TAPPED_FORMULA_PATTERN.fullmatch(name))
            for name in names
        ):
            # Non-plain forms (Casks, flags, URLs, etc.) retain native behavior.
            if dry_run or yes:
                raise BottleError("--dry-run and --yes work only with Formula names")
            return passthrough(args)
        # An explicit third-party reference can auto-tap on installation.
        # Do not require brew info to work before the Tap has been added.
        explicit_third_party = [
            name for name in names
            if TAPPED_FORMULA_PATTERN.fullmatch(name)
            and not name.startswith(CORE_TAP + "/")
        ]
        if explicit_third_party:
            message("third-party Tap formula(s): " + ", ".join(explicit_third_party))
            # The fully qualified Formula may automatically add its Tap.
            # Still qualify other short names, if their metadata is available.
            shorts = [name for name in names if FORMULA_PATTERN.fullmatch(name)]
            native_args = args
            if shorts:
                short_roots = requested_packages(shorts)
                native_args = native_tap_install_args(rest, shorts, short_roots)
            message("delegating the entire install to native Homebrew")
            return passthrough(native_args)
        roots = requested_packages(names)
        native_only = [
            info for info in roots
            if info.get("kind", "formula") == "cask" or info["tap"] != CORE_TAP
        ]
        if native_only:
            # Native Homebrew handles all Casks and third-party Formulae,
            # preserving their original install semantics and dependencies.
            details = [
                (info.get("full_name") or f"{info['tap']}/{info['name']}")
                + (" [Cask]" if info.get("kind") == "cask" else " [third-party Formula]")
                for info in native_only
            ]
            message("native Homebrew package(s): " + ", ".join(details))
            message("delegating the entire install to native Homebrew"
                    + (" (including any homebrew/core Formulae)" if len(native_only) != len(roots) else ""))
            return passthrough(native_tap_install_args(rest, names, roots))
        try:
            return install([info["name"] for info in roots], dry_run=dry_run, yes=yes)
        except ThirdPartyDependency as exc:
            message(str(exc))
            message("delegating the entire install to native Homebrew")
            return passthrough(args)
    return passthrough(args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (BottleError, ValueError, KeyError, json.JSONDecodeError) as exc:
        message("ERROR: " + str(exc))
        sys.exit(1)